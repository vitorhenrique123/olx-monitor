{
  "name": "olx-monitor",
  "version": "1.0.0",
  "description": "Programa que monitora novos anúncios feitos no OLX, alteração de preços em anúncios existentes e envia notificações pelo Telegram.",
  "main": "index.js",
  "bin": "index.js",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.3",
    "cycletls": "^1.0.24",
    "dotenv": "^8.2.0",
    "express": "^5.2.1",
    "form-data": "^4.0.0",
    "node-cron": "^3.0.2",
    "sqlite3": "^5.1.6"
  },
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:win": "node scripts/build-win.js"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "keywords": [
    "olx",
    "scrapper",
    "monitor",
    "alert",
    "telegram"
  ],
  "author": "Augusto Carmo",
  "license": "MIT",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "nodemon": "^3.0.1"
  }
}
